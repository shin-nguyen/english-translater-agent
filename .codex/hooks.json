{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/block_secrets.py",
            "timeout": 10,
            "statusMessage": "Checking command against .env-file policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/audit_log.py",
            "timeout": 10,
            "statusMessage": "Writing audit log entry",
            "async": true
          }
        ]
      }
    ]
  }
}
