# Copy this file to `.env` in the repo root and fill in the values you need.
# `docker compose` reads `.env` automatically — this is the config for the
# full `docker compose up` stack (postgres + backend + frontend).

# --- Postgres ---
POSTGRES_DB=translator
POSTGRES_USER=translator
POSTGRES_PASSWORD=translator

# --- Backend / AI provider ---
# openrouter (default) or anthropic
TRANSLATION_PROVIDER=openrouter

# Required if TRANSLATION_PROVIDER=openrouter — get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=
#OPENROUTER_MODEL=openai/gpt-oss-20b:free
OPENROUTER_MODEL=inclusionai/ling-3.0-flash:free

# Required if TRANSLATION_PROVIDER=anthropic — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Origins allowed to call the backend API (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Frontend ---
# Baked into the static bundle at image build time — must be a URL your
# BROWSER can reach, not a Docker-internal hostname (e.g. not http://backend:8080).
VITE_API_BASE_URL=http://localhost:8080
