# Copy this file to `.env` in the repo root and fill in the values you need.
# `docker compose` reads `.env` automatically — this is the config for the
# full `docker compose up` stack (postgres + backend + frontend).

# --- Postgres ---
POSTGRES_DB=translator
POSTGRES_USER=translator
POSTGRES_PASSWORD=translator

# --- Backend / auth & encryption secrets ---
# Both required. Generate each with: openssl rand -base64 32
# Signs/verifies login JWTs. If this changes, every issued token is invalidated (all users
# must log in again).
APP_JWT_SECRET=
# Encrypts AI model API keys at rest in Postgres (AES-256-GCM). If this changes, every
# previously saved AI model's API key becomes undecryptable — re-enter it via the admin UI.
AI_MODEL_ENCRYPTION_KEY=

# Origins allowed to call the backend API (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- AI provider config ---
# There is no env var for this anymore. The first account you sign up through the app
# becomes an admin automatically — log in as that admin and add at least one AI model
# (provider, base URL, API key, model id) under "AI Models" in the nav before translating.
# Works with OpenRouter, Anthropic directly, or any self-hosted OpenAI-compatible server
# (vLLM/llama.cpp/Ollama/etc).

# --- Frontend ---
# Baked into the static bundle at image build time — must be a URL your
# BROWSER can reach, not a Docker-internal hostname (e.g. not http://backend:8080).
VITE_API_BASE_URL=http://localhost:8080
